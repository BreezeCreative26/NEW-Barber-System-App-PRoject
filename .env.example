DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=

# 1 = demo shop available from the sign-in page (and POST /api/app/auth/demo). Leave unset in production.
DEMO_ENABLED=

# Signups per IP per 10 minutes (default 60).
SIGNUP_IP_LIMIT=

# Messaging (all optional; without them messages land in the dev mailbox, visible under
# Settings → Messages when DEMO_ENABLED=1). Emails go out as "<Shop name> <MAIL_FROM>".
RESEND_API_KEY=
# MAIL_FROM: an address on a domain verified in Resend (Domains → Add). Unset = onboarding@resend.dev, which only delivers to the Resend account owner.
MAIL_FROM=
# SMS: ClickSend (preferred) — username is the account email, key from Developers → API credentials.
# CLICKSEND_FROM is an optional alphanumeric sender (≤11 chars) used when the shop has none.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
# …or Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+44xxxxxxxxxx
# or TWILIO_MESSAGING_SERVICE_SID=
# Vercel Cron calls /api/cron/messages every 5 min with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Stripe — OLLO is the Connect platform and merchant of record (docs/STRIPE_PLAN.md).
# Leave unset for preview mode (deposits payable in the shop, pay runs record but move nothing).
STRIPE_SECRET_KEY=
# From `node scripts/stripe-setup.mjs` (registers /api/stripe/webhook and prints the signing secret).
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT=0 only for a single-shop deploy where the platform account IS the shop.

# Abuse controls (defaults shown). Public GETs per IP / 10 min; login attempts per IP / 10 min.
PUBLIC_READ_LIMIT=600
LOGIN_IP_LIMIT=60
# Error tracking: a Sentry DSN turns on delivery; without it errors go to the server log only.
SENTRY_DSN=
