DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=

# 1 = demo shop available from the sign-in page (and POST /api/app/auth/demo). Leave unset in production.
DEMO_ENABLED=

# Signups per IP per 10 minutes (default 60).
SIGNUP_IP_LIMIT=

# Messaging (all optional; without them messages land in the dev mailbox, visible under
# Settings → Messages when DEMO_ENABLED=1). Emails go out as "<Shop name> <MAIL_FROM>".
RESEND_API_KEY=
# MAIL_FROM: an address on a domain verified in Resend (Domains → Add). Unset = onboarding@resend.dev, which only delivers to the Resend account owner.
MAIL_FROM=
# SMS: Telnyx (preferred — one account for texts and, later, calls). Run `node scripts/telnyx-setup.mjs`
# once to create the messaging profile, point its webhook at /api/telnyx/webhook and print the IDs.
# TELNYX_FROM is an E.164 number on that profile; the shop's own alphanumeric sender is used where the
# destination allows it (UK). TELNYX_PUBLIC_KEY (Mission Control → Keys → Public key) verifies webhooks.
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM=
TELNYX_PUBLIC_KEY=
# …or ClickSend — username is the account email, key from Developers → API credentials.
# CLICKSEND_FROM is an optional alphanumeric sender (≤11 chars) used when the shop has none.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
# …or Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+44xxxxxxxxxx
# or TWILIO_MESSAGING_SERVICE_SID=
# Vercel Cron calls /api/cron/messages every 5 min with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Stripe — foliyo is the Connect platform and merchant of record (docs/STRIPE_PLAN.md).
# Leave unset for preview mode (deposits payable in the shop, pay runs record but move nothing).
STRIPE_SECRET_KEY=
# From `node scripts/stripe-setup.mjs` (registers /api/stripe/webhook and prints the signing secret).
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT=0 only for a single-shop deploy where the platform account IS the shop.

# Abuse controls (defaults shown). Public GETs per IP / 10 min; login attempts per IP / 10 min.
PUBLIC_READ_LIMIT=600
LOGIN_IP_LIMIT=60
# Error tracking: a Sentry DSN turns on delivery; without it errors go to the server log only.
SENTRY_DSN=

# WhatsApp via Infobip — one foliyo sender shared by every shop (shop name is the first placeholder
# in each template). INFOBIP_WA_SENDER=447860088970 is Infobip's shared test sender: only phones
# that first WhatsApp the keyword to it receive messages, and only stock templates work. Register
# foliyo's own number in the Infobip portal, then run: node scripts/whatsapp-templates.mjs --submit
# INFOBIP_WEBHOOK_KEY (optional) must be sent by Infobip as ?key= on /api/whatsapp/status|inbound.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=api.infobip.com
INFOBIP_WA_SENDER=
INFOBIP_WEBHOOK_KEY=

# Web Push for the per-shop installed app (customer notifications). Generate once with
# `npx web-push generate-vapid-keys`; unset = push off, texts/emails unaffected.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:hello@foliyo.co.uk
