{
  "name": "barbershop-os",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.client.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply barbershop-os-local --local",
    "test:e2e": "playwright test",
    "test:db": "node tests/d1-invariants.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:db && npm run test:e2e",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.13.7",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^5.0.0",
    "wrangler": "^4.110.0"
  }
}
