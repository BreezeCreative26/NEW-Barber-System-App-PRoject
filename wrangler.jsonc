{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barbershop-os-local",
  "compatibility_date": "2026-09-08",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  // Local development placeholder only. No production database provisioned.
  // APP_MODE=sandbox belongs exclusively in ignored .dev.vars.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barbershop-os-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  // Uploaded shop photos. Local development uses wrangler's built-in local R2; nothing is provisioned.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "barbershop-os-media-local" }],
}
